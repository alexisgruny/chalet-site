# Clé API Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Adresse existante qui recevra les messages du formulaire
CONTACT_EMAIL=adresse-du-proprietaire@example.com

# Adresse d'expédition Resend ; onboarding@resend.dev est temporaire
RESEND_FROM_EMAIL=Chalet Jaïa <onboarding@resend.dev>

# Clé secrète Stripe (utiliser une clé de test en développement)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Upstash Redis (créé via Vercel → Storage → Marketplace → Upstash ; variables ajoutées automatiquement)
KV_REST_API_URL=https://xxxx.upstash.io
KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxx

# Flux iCal à importer, format source=url séparés par des virgules
ICAL_IMPORT_URLS=airbnb=https://www.airbnb.fr/calendar/ical/xxxx.ics?s=xxxx,booking=https://ical.booking.com/v1/export?t=xxxx

# Secret partagé avec la tâche planifiée (GitHub Actions) qui appelle /api/cron/sync-calendars
CRON_SECRET=une-longue-chaine-aleatoire

# Jeton pour gérer les réservations directes via /api/admin/bookings
ADMIN_TOKEN=une-autre-longue-chaine-aleatoire
